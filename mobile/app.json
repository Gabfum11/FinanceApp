{
  "expo": {
    "name": "TrackIt",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/saldo-icon-1024.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.gabrifu03.trackIt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/saldo-mark-transparent-1024.png",
        "backgroundColor": "#2ECC71"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/saldo-icon-1024.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e11f8773-e265-4a1c-a5e9-13ecee9d300e"
      }
    },
    "owner": "gabrifu03"
  }
}
